model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_date","dim_scenario","dim_series","fact_scenario_validation","fact_replenishment","fact_forecast","_Medidas"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode"]

ref table dim_date
ref table dim_scenario
ref table dim_series
ref table fact_scenario_validation
ref table fact_replenishment
ref table fact_forecast
ref table _Medidas

ref cultureInfo pt-BR
